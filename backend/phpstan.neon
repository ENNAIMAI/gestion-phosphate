includes:
    - ./vendor/larastan/larastan/extension.neon

parameters:
    paths:
        - app/
        - config/
        - database/
        - routes/

    # Analysis level
    level: 8

    ignoreErrors:
        - '#Unsafe usage of new static\(\)#'

    excludePaths:
        - ./*/*/FileToBeExcluded.php
